)
_CICC_ARCH_RE = re.compile(r"(?<!\S)-arch\s+\"?compute_(\d+)[af]?")
_OUT_RE = re.compile(r'(?<!\S)-o\s+(?:"([^"]*)"|(\S+))')
_FATBIN_PTX_RE = re.compile(
    r'\s(?:"--image3=kind=ptx,[^"]*"|--image3=kind=ptx,\S*|"--image=profile=compute_[^"]*"|--image=profile=compute_\S*)'
)
_FATBIN_ELF_RE = re.compile(r"(--image3=kind=elf,sm=)(\d+)[af]?")
_FATBIN_OLD_RE = re.compile(r"(--image=profile=sm_)(\d+)[af]?")
_FATBIN_LTO_RE = re.compile(r"--image3=kind=(?!elf|ptx)\w+")
_INCLUDE_RE = re.compile(r'^(\s*#\s*include\s*)"([^"]+)"', re.M)


