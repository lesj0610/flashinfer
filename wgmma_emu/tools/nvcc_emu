def find_real_nvcc() -> str:
    me = os.path.realpath(__file__)
    cands: list[tuple[str, str]] = []
    env = os.environ.get("WGEMU_REAL_NVCC")
    if env:
        cands.append(("WGEMU_REAL_NVCC", env))
    else:
        marker = Path(os.path.abspath(sys.argv[0])).parent.parent / SHADOW_MARKER
        if marker.is_file():
            cands.append(
                (str(marker), str(Path(marker.read_text().strip()) / "bin" / "nvcc"))
            )
        home = os.environ.get("CUDA_HOME")
        if home:
            hm = Path(home) / SHADOW_MARKER
            if hm.is_file():
                cands.append(
                    (str(hm), str(Path(hm.read_text().strip()) / "bin" / "nvcc"))
                )
            else:
                cands.append(("CUDA_HOME", str(Path(home) / "bin" / "nvcc")))
        cands.append(("default", "/usr/local/cuda/bin/nvcc"))
    for origin, path in cands:
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            if origin == "WGEMU_REAL_NVCC" or origin.endswith(SHADOW_MARKER):
                raise EmuError(f"real nvcc from {origin} is not executable: {path}")
            continue
        if os.path.realpath(path) == me:
            if origin in ("WGEMU_REAL_NVCC",) or origin.endswith(SHADOW_MARKER):
                raise EmuError(
                    f"real nvcc from {origin} resolves to nvcc_emu itself: {path}"
                )
            continue
        return path
    raise EmuError("cannot find the real nvcc; set WGEMU_REAL_NVCC")


def _hash_tree(h: Any, base: Path) -> None:
    if not base.is_dir():
        return
    for f in sorted(base.rglob("*")):
        if not f.is_file() or "__pycache__" in f.parts or f.suffix == ".pyc":
            continue
        h.update(str(f.relative_to(ROOT)).encode() + b"\0")
        h.update(f.read_bytes() + b"\0")


def library_plan(real_nvcc: str) -> tuple[Path, list[str] | None]:
    """(emu_lib.ptx path, build command or None if it already exists / was given)."""
    given = os.environ.get("WGEMU_LIB")
    if given:
        p = Path(given)
        if not p.is_file():
            raise EmuError(f"WGEMU_LIB={given} does not exist")
        return p, None
    src = ROOT / "runtime" / "emu_lib.cu"
    if not src.is_file():
        raise EmuError(
            f"emulation library source {src} not found (or set WGEMU_LIB=<emu_lib.ptx>)"
        )
    cmd = [
        real_nvcc,
        "-arch=compute_80",
        "-rdc=true",
        "--ptx",
        "-O3",
        "-std=c++17",
        "-I",
        str(ROOT / "include"),
        str(src),
        "-o",
    ]
    h = hashlib.sha256()
    _hash_tree(h, ROOT / "runtime")
    _hash_tree(h, ROOT / "include")
    ver = subprocess.run(
        [real_nvcc, "--version"], capture_output=True, text=True, check=False
    )
    if ver.returncode != 0:
        raise EmuError(f"{real_nvcc} --version failed: {ver.stderr.strip()}")
    h.update(ver.stdout.encode())
    h.update("\0".join(cmd[1:]).encode())
    cache = Path(os.environ.get("WGEMU_CACHE_DIR") or Path.home() / ".cache" / "wgemu")
    out = cache / f"emu_lib.{h.hexdigest()[:20]}.ptx"
    return out, (None if out.is_file() else cmd)


def ensure_library(path: Path, cmd: list[str] | None) -> None:
    if cmd is None:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if path.is_file():
            return
        fd, tmp = tempfile.mkstemp(
            prefix=path.stem + ".", suffix=".tmp.ptx", dir=path.parent
        )
        os.close(fd)
        try:
            r = subprocess.run([*cmd, tmp], capture_output=True, text=True, check=False)
            if r.returncode != 0:
                raise EmuError(
                    f"building the emulation library failed (rc={r.returncode}):\n{shlex.join([*cmd, tmp])}\n{r.stdout}{r.stderr}"
                )
            os.replace(tmp, path)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)


