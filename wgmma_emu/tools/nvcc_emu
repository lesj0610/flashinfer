def expand_options_files(args: list[str]) -> list[str]:
    out: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        name, eq, val = a.partition("=")
        if name in ("-optf", "--options-file"):
            if not eq:
                if i + 1 >= len(args):
                    raise EmuError(f"{a} needs a value")
                val = args[i + 1]
                i += 1
            for f in val.split(","):
                out.extend(expand_options_files(shlex.split(Path(f).read_text())))
        else:
            out.append(a)
        i += 1
    return out


def split_shadow_spec(spec: str) -> tuple[str, str, str]:
    parts: list[str] = []
    cur: list[str] = []
    i = 0
    while i < len(spec):
        c = spec[i]
        if c == "\\" and i + 1 < len(spec) and spec[i + 1] == ":":
            cur.append(":")
            i += 2
            continue
        if c == ":":
            parts.append("".join(cur))
            cur = []
        else:
            cur.append(c)
        i += 1
    parts.append("".join(cur))
    if len(parts) != 3 or not parts[0] or not parts[1]:
        raise EmuError(
            f"--wgemu-shadow expects <relpath>:<regex>:<replacement>, got {spec!r}"
        )
    return parts[0], parts[1], parts[2]


class Parsed:
    def __init__(self) -> None:
        self.forward: list[str] = []
        self.inputs: list[str] = []
        self.output: str | None = None
        self.keep = False
        self.keep_dir: str | None = None
        self.dryrun = False
        self.verbose = False
        self.include_dirs: list[str] = []
        self.shadow: list[tuple[str, str, str]] = []
        # dependency output (-MD/-MMD with -MF/-MT): written by a separate real-nvcc -M run,
        # since nvcc -dryrun lists it as an internal "-- Filter Dependencies --" step
        self.dep_mode: str | None = None
        self.dep_file: str | None = None
        self.dep_target: str | None = None


def parse_args(args: list[str]) -> Parsed:
    p = Parsed()
    i = 0
    n = len(args)
    while i < n:
        a = args[i]
        if not a.startswith("-") or a == "-":
            p.inputs.append(a)
            p.forward.append(a)
            i += 1
            continue
        name, eq, val = a.partition("=")
        if name in UNSUPPORTED_OPTS:
            raise EmuError(f"{name} is not supported: {UNSUPPORTED_OPTS[name]}")
        takes_next = name in VALUE_OPTS and not eq
        if takes_next:
            if i + 1 >= n:
                raise EmuError(f"option {name} needs a value")
            val = args[i + 1]
        step = 2 if takes_next else 1
        if name in ARCH_OPTS:
            pass  # replaced by the normalized -gencode
        elif name == "--wgemu-shadow":
            p.shadow.append(split_shadow_spec(val))
        elif a in ("-keep", "--keep", "-save-temps", "--save-temps"):
            p.keep = True
        elif name in ("-keep-dir", "--keep-dir"):
            p.keep_dir = val
        elif a in ("-dryrun", "--dryrun"):
            p.dryrun = True
        elif a in ("-v", "--verbose"):
            p.verbose = True
        elif a in ("-MD", "--generate-dependencies-with-compile"):
            p.dep_mode = "-M"
        elif a in ("-MMD", "--generate-nonsystem-dependencies-with-compile"):
            p.dep_mode = "-MM"
        elif name in ("-MF", "--dependency-output"):
            p.dep_file = val
        elif name in ("-MT", "--dependency-target-name"):
            p.dep_target = val
        else:
            if name in ("-o", "--output-file"):
                p.output = val
            elif name in ("-I", "--include-path", "-isystem", "--system-include"):
                p.include_dirs.extend(v for v in val.split(",") if v)
            elif a.startswith("-I") and len(a) > 2 and not eq:
                p.include_dirs.append(a[2:])
            p.forward.extend(args[i : i + step])
        i += step
    return p


def default_keep_dir(p: Parsed, cwd: Path) -> tuple[Path, bool]:
    """(directory, is_temporary)."""
    if p.keep_dir:
        return Path(p.keep_dir).resolve(), False
    if p.keep:
        return cwd, False  # nvcc -keep writes intermediates to the current directory
    if p.output and not os.path.abspath(p.output).startswith("/dev/"):
        return Path(os.path.abspath(p.output + ".wgemu.d")), False
    if not p.output and p.inputs:
        return cwd / (Path(p.inputs[0]).name + ".wgemu.d"), False
    return Path(tempfile.mkdtemp(prefix="nvcc_emu.")), True


def make_shadow_headers(p: Parsed, kd: Path) -> list[str]:
    if not p.shadow:
        return []
    root = kd / "wgemu_shadow"
    grouped: dict[str, list[tuple[str, str]]] = {}
    for rel, rx, repl in p.shadow:
        grouped.setdefault(rel, []).append((rx, repl))
    for rel, subs in grouped.items():
        src = None
        for d in p.include_dirs:
            cand = Path(d) / rel
            if cand.is_file():
                src = cand.resolve()
                break
        if src is None:
            raise EmuError(
                f"--wgemu-shadow: {rel} not found in the include path {p.include_dirs}"
            )
        text = src.read_text()
        for rx, repl in subs:
            try:
                text, count = re.subn(rx, repl, text, flags=re.M)
            except re.error as e:
                raise EmuError(f"--wgemu-shadow {rel}: bad regex {rx!r}: {e}") from None
            if count == 0:
                raise EmuError(
                    f"--wgemu-shadow {rel}: regex {rx!r} matched nothing in {src}"
                )

        def absolute(m: re.Match, base: Path = src.parent) -> str:
            name = m.group(2)
            target = base / name
            if not os.path.isabs(name) and target.is_file():
                return f'{m.group(1)}"{target.resolve()}"'
            return m.group(0)

        text = _INCLUDE_RE.sub(absolute, text)
        dst = root / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(text)
    return [f"-I{root}"]


def normalize_arch() -> str:
    a = os.environ.get("WGEMU_SRC_ARCH", "90a")
    # 89 / 86: sm_8x sources (e.g. sm_89 fp8 mma) translated for sm_80.
    if a not in ("90a", "90", "89", "86"):
        raise EmuError(f"WGEMU_SRC_ARCH={a} (expected 90a, 90, 89 or 86)")
    return f"-gencode=arch=compute_{a},code=sm_{a}"


# ---------------------------------------------------------------------------------------------
# Command rewriting
# ---------------------------------------------------------------------------------------------


def parse_env_value(raw: str) -> str:
    v = raw.rstrip()
    if len(v) >= 2 and v[0] == '"' and v[-1] == '"' and v.count('"') == 2:
        v = v[1:-1]
    return v


def tool_of(cmd: str) -> str:
    try:
        first = shlex.split(cmd)[0]
    except (ValueError, IndexError):
        first = cmd.split()[0] if cmd.split() else ""
    return os.path.basename(first)


def _rewrite_arch(cmd: str) -> str:
    def sub(m: re.Match) -> str:
        if int(m.group("num")) <= 80:
            return m.group(0)
        return f"{m.group('pre')}{m.group('kind')}_80"

    return _TOOL_ARCH_RE.sub(sub, cmd)


def rewrite_fatbinary(cmd: str) -> str:
    m = _FATBIN_LTO_RE.search(cmd)
    if m:
        raise EmuError(f"fatbinary image {m.group(0)} is not supported")
    out = _FATBIN_PTX_RE.sub("", cmd)
    out = _FATBIN_ELF_RE.sub(
        lambda m: m.group(1) + ("80" if int(m.group(2)) > 80 else m.group(2)), out
    )
    return _FATBIN_OLD_RE.sub(
        lambda m: m.group(1) + ("80" if int(m.group(2)) > 80 else m.group(2)), out
    )


def cicc_output(cmd: str) -> tuple[int, str] | None:
    """(compute arch, -o path) of a cicc command that needs translation, else None."""
    m = _CICC_ARCH_RE.search(cmd)
    if not m or int(m.group(1)) <= 80:
        return None
    outs = _OUT_RE.findall(cmd)
    if not outs:
        raise EmuError(f"cannot find the cicc output in: {cmd}")
    path = outs[-1][0] or outs[-1][1]
    if not path.endswith(".ptx"):
        raise EmuError(
            f"cicc output {path} is not PTX (LTO / NVVM IR output is not supported)"
        )
    return int(m.group(1)), path


def ptxas_inputs(cmd: str) -> list[str]:
    toks = shlex.split(cmd)
    out = []
    for k, t in enumerate(toks[1:], 1):
        if t.endswith(".ptx") and toks[k - 1] != "-o" and not t.startswith("-"):
            out.append(t)
    return out


def replace_path(cmd: str, old: str, new: str) -> str:
    q_old = f'"{old}"'
    if q_old in cmd:
        return cmd.replace(q_old, f'"{new}"')
    rx = re.compile(r"(?<!\S)" + re.escape(old) + r"(?!\S)")
    if not rx.search(cmd):
        raise EmuError(f"cannot locate {old} in: {cmd}")
    return rx.sub(lambda _m: shlex.quote(new), cmd)


