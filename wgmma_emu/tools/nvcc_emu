class Driver:
    def __init__(self, real: str, p: Parsed, kd: Path) -> None:
        self.real = real
        self.p = p
        self.kd = kd
        self._lib: Path | None = None
        self.mode = os.environ.get("WGEMU_MODE", "exact")
        if self.mode not in ("exact", "fast", "check"):
            raise EmuError(f"WGEMU_MODE={self.mode} (expected exact, fast or check)")
        self.trap = os.environ.get("WGEMU_TRAP") == "1"
        self.allow_cluster = os.environ.get("WGEMU_ALLOW_CLUSTER") == "1"
        self.async_delay = os.environ.get("WGEMU_ASYNC_DELAY") == "1"
        self.count = os.environ.get("WGEMU_COUNT") == "1"
        self.dl_slots = os.environ.get("WGEMU_DL_SLOTS", "")
        self.dl_records = os.environ.get("WGEMU_DL_RECORDS", "")
        for name, val in (
            ("WGEMU_DL_SLOTS", self.dl_slots),
            ("WGEMU_DL_RECORDS", self.dl_records),
        ):
            if val and not val.isdigit():
                raise EmuError(f"{name}={val} (expected a positive integer)")
        self.inventory = os.environ.get("WGEMU_INVENTORY")
        self.translated: set[str] = set()
        self.stems: dict[str, int] = {}
        self.script: list[str] = [
            "#!/usr/bin/env bash",
            "set -e",
            f"cd {shlex.quote(os.getcwd())}",
        ]
        self.cwd = Path.cwd()

    def echo(self, line: str) -> None:
        if self.p.verbose or self.p.dryrun:
            print(f"#$ {line}", file=sys.stderr)

    def library(self) -> Path:
        """emu_lib.ptx, built (or found in the cache) on first use."""
        if self._lib is None:
            lib, cmd = library_plan(self.real)
            if cmd is not None:
                self.script.append(
                    shlex.join([*cmd, str(lib)]) + "   # emulation library build"
                )
                self.echo(shlex.join([*cmd, str(lib)]) + "   # emulation library build")
                if not self.p.dryrun:
                    ensure_library(lib, cmd)
            self._lib = lib
        return self._lib

    def translate(self, src: str, dst: str) -> None:
        srcp = (self.cwd / src).resolve()
        dstp = (self.cwd / dst).absolute()
        stem = srcp.stem
        n = self.stems.get(stem, 0)
        self.stems[stem] = n + 1
        if n:
            stem = f"{stem}.{n}"
        orig = self.kd / f"{stem}.wgemu_orig.ptx"
        report = self.kd / f"{stem}.wgemu_report.json"
        argv = [
            str(orig),
            "-o",
            str(dstp),
            "--lib",
            str(self.library()),
            "--mode",
            self.mode,
            "--report",
            str(report),
        ]
        if self.trap:
            argv.append("--trap")
        if self.allow_cluster:
            argv.append("--allow-cluster")
        if self.async_delay:
            argv.append("--async-delay")
            if self.dl_slots:
                argv += ["--dl-slots", self.dl_slots]
            if self.dl_records:
                argv += ["--dl-records", self.dl_records]
        if self.count:
            argv.append("--count")
        if self.inventory:
            argv += ["--inventory", self.inventory]
        shell = f"cp {shlex.quote(str(srcp))} {shlex.quote(str(orig))} && PYTHONPATH={shlex.quote(str(TOOLS_DIR))} {shlex.quote(sys.executable)} -m ptxemu {shlex.join(argv)}"
        self.script.append(shell)
        self.echo(shell)
        if not self.p.dryrun:
            shutil.copyfile(srcp, orig)
            if str(TOOLS_DIR) not in sys.path:
                sys.path.insert(0, str(TOOLS_DIR))
            from ptxemu import cli  # noqa: PLC0415

            rc = cli.main(argv)
            self.write_check(stem, report, rc)
            if rc != 0:
                raise EmuError(f"ptxemu failed (rc={rc}) on {srcp}; see {report}")
        # recorded in dry runs too, so a later ptxas step does not list a second translation
        self.translated.add(str(dstp))

    def write_check(self, stem: str, report: Path, rc: int) -> None:
        lines = [f"ptxemu exit status: {rc}"]
        try:
            rep = json.loads(report.read_text())
        except (OSError, ValueError) as e:
            lines.append(f"no report: {e}")
            rep = {}
        if "error" in rep:
            lines.append(f"translation error: {rep['error']}")
        chk = rep.get("check") or {}
        rem = chk.get("remaining")
        if rem is not None:
            lines.append(f"remaining sm_{chk.get('min_sm')}+ items: {len(rem)}")
            lines += [
                f"  line {r['line']}: {r['kind']} {r['token']} (inventory {r['inventory']!r})"
                for r in rem
            ]
        (self.kd / f"{stem}.wgemu_check.txt").write_text("\n".join(lines) + "\n")

    def run_cmd(self, cmd: str, env: dict[str, str]) -> None:
        tool = tool_of(cmd)
        post = None
        if tool == "cicc":
            post = cicc_output(cmd)
        elif tool == "ptxas":
            cmd = _rewrite_arch(cmd)
            for inp in ptxas_inputs(cmd):
                absp = str((self.cwd / inp).absolute())
                if absp in self.translated:
                    continue
                stem = Path(inp).stem
                dst = self.kd / f"{stem}.wgemu_input.ptx"
                self.translate(inp, str(dst))
                cmd = replace_path(cmd, inp, str(dst))
        elif tool == "nvlink":
            cmd = _rewrite_arch(cmd)
        elif tool == "fatbinary":
            cmd = rewrite_fatbinary(cmd)
        self.script.append(cmd)
        self.echo(cmd)
        if not self.p.dryrun:
            r = subprocess.run(["bash", "-c", cmd], env=env, cwd=self.cwd, check=False)
            if r.returncode != 0:
                if tool == "rm":
                    pass  # nvcc removes a stale file that usually does not exist
                else:
                    raise EmuError(
                        f"command failed (rc={r.returncode}): {cmd}", r.returncode
                    )
        if post is not None:
            _, out = post
            self.translate(out, out)


def cleanup(kd: Path, temp: bool, before: set[str]) -> None:
    if temp:
        shutil.rmtree(kd, ignore_errors=True)
        return
    for f in kd.iterdir():
        if (
            f.name in before
            or not f.is_file()
            or "wgemu" in f.name
            or f.suffix == ".ptx"
        ):
            continue
        f.unlink()


def write_deps(real: str, p: Parsed, fwd: list[str]) -> int:
    """Dependency file for -MD/-MMD: real nvcc -M/-MM over the same inputs and flags."""
    if p.dep_file is None:
        log("error: -MD/-MMD without -MF is not supported")
        return 1
    args: list[str] = []
    i = 0
    while i < len(fwd):
        a = fwd[i]
        if a in ("-o", "--output-file"):
            i += 2
            continue
        if a.startswith(("-o=", "--output-file=")) or a in ("-c", "--compile"):
            i += 1
            continue
        args.append(a)
        i += 1
    target = p.dep_target or p.output
    cmd = [real, p.dep_mode, *args, "-o", p.dep_file]
    if target:
        cmd[2:2] = ["-MT", target]
    r = subprocess.run(cmd, check=False)
    if r.returncode != 0:
        log(f"error: dependency generation failed (rc={r.returncode})")
    return r.returncode


def main(argv: list[str]) -> int:
    real = find_real_nvcc()
    if (
        os.environ.get("WGEMU_DISABLE") == "1"
        or not argv
        or any(a in INFO_FLAGS for a in argv)
    ):
        os.execv(real, [real, *argv])
    args = expand_options_files(argv)
    p = parse_args(args)
    cwd = Path.cwd()
    kd, temp = default_keep_dir(p, cwd)
    kd.mkdir(parents=True, exist_ok=True)
    before = {f.name for f in kd.iterdir()}
    fwd = [normalize_arch(), *make_shadow_headers(p, kd), *p.forward]
    dry = subprocess.run(
        [real, "-dryrun", "-keep", "-keep-dir", str(kd), *fwd],
        capture_output=True,
        text=True,
        check=False,
    )
    if dry.stdout:
        sys.stdout.write(dry.stdout)
    if dry.returncode != 0:
        sys.stderr.write(dry.stderr)
        return dry.returncode
    drv = Driver(real, p, kd)
    env = dict(os.environ)
    cmds: list[str] = []
    for line in dry.stderr.splitlines():
        if not line.startswith("#$ "):
            if line.strip():
                print(line, file=sys.stderr)
            continue
        body = line[3:]
        m = _ENV_LINE_RE.match(body)
        if m:
            env[m.group(1)] = parse_env_value(m.group(2))
            drv.script.append(f"export {m.group(1)}={shlex.quote(env[m.group(1)])}")
            drv.echo(body)
        else:
            cmds.append(body)
    try:
        for cmd in cmds:
            drv.run_cmd(cmd, env)
    except EmuError as e:
        rc = e.args[1] if len(e.args) > 1 else 1
        log(f"error: {e.args[0]}")
        log(f"keeping intermediate files in {kd}")
        _write_script(drv, kd)
        return rc
    _write_script(drv, kd)
    if p.dep_mode and not p.dryrun:
        rc = write_deps(real, p, fwd)
        if rc != 0:
            return rc
    if not p.dryrun and not p.keep and os.environ.get("WGEMU_KEEP") != "1":
        cleanup(kd, temp, before)
    return 0


def _write_script(drv: Driver, kd: Path) -> None:
    try:
        (kd / "wgemu_cmds.sh").write_text("\n".join(drv.script) + "\n")
    except OSError as e:
        log(f"warning: cannot write {kd / 'wgemu_cmds.sh'}: {e}")


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except EmuError as e:
        log(f"error: {e.args[0]}")
        sys.exit(e.args[1] if len(e.args) > 1 else 1)
